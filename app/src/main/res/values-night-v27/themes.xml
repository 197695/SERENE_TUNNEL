<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SereneTunnel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/serene_background</item>
        <item name="android:navigationBarColor">@color/serene_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.SereneTunnel.Starting" parent="Theme.SereneTunnel">
        <item name="android:windowBackground">@drawable/serene_starting_window</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
